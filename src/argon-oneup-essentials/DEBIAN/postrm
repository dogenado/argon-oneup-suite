#!/bin/sh
set -e

remove_config_block() {
    cfg="$1"
    [ -f "$cfg" ] || return 0

    # Only delete the block when both markers are present. A missing END marker
    # would otherwise make sed delete everything from BEGIN to the end of file.
    if grep -q '^# --- BEGIN ARGON-ONEUP-ESSENTIALS ---$' "$cfg" &&
       grep -q '^# --- END ARGON-ONEUP-ESSENTIALS ---$' "$cfg"; then
        sed -i '/^# --- BEGIN ARGON-ONEUP-ESSENTIALS ---$/,/^# --- END ARGON-ONEUP-ESSENTIALS ---$/d' "$cfg" 2>/dev/null || true
    fi

    sed -i 's/^#camera_auto_detect=1 (handled by argon-oneup-essentials)/camera_auto_detect=1/' "$cfg" 2>/dev/null || true
    sed -i 's/^#display_auto_detect=1 (handled by argon-oneup-essentials)/display_auto_detect=1/' "$cfg" 2>/dev/null || true
    sed -i 's/^#dtparam=audio=on (obsolete on Pi 5\/CM5)/dtparam=audio=on/' "$cfg" 2>/dev/null || true
}

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    for cfg in /boot/firmware/config.txt /boot/config.txt; do
        remove_config_block "$cfg"
    done

    # Do not leave an enabled APT source behind. dpkg removes the keyring as a
    # normal package file on remove, and a dangling Signed-By entry makes
    # "apt update" fail until the source is removed manually.
    for sources in /etc/apt/sources.list.d/argon-oneup.sources /etc/apt/sources.list.d/argon-oneup.list; do
        if [ -f "$sources" ] && grep -q 'gamingtux.github.io/argon-oneup-suite' "$sources" 2>/dev/null; then
            rm -f "$sources"
        fi
    done
    rm -f /usr/share/keyrings/argon-oneup-archive-keyring.gpg \
          /usr/share/keyrings/argon-oneup-archive-keyring.asc 2>/dev/null || true
fi

exit 0
