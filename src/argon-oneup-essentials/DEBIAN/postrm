#!/bin/sh
set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    for cfg in /boot/firmware/config.txt /boot/config.txt; do
        if [ -f "$cfg" ]; then
            sed -i '/^# --- BEGIN ARGON-ONEUP-ESSENTIALS ---$/,/^# --- END ARGON-ONEUP-ESSENTIALS ---$/d' "$cfg" 2>/dev/null || true
            sed -i 's/^#camera_auto_detect=1 (handled by argon-oneup-essentials)/camera_auto_detect=1/' "$cfg" 2>/dev/null || true
            sed -i 's/^#display_auto_detect=1 (handled by argon-oneup-essentials)/display_auto_detect=1/' "$cfg" 2>/dev/null || true
            sed -i 's/^#dtparam=audio=on (obsolete on Pi 5\/CM5)/dtparam=audio=on/' "$cfg" 2>/dev/null || true
        fi
    done

    # Remove the files generated by argon-essentials-apply and reverse the
    # optional Ethernet power-down.
    rm -f /etc/NetworkManager/conf.d/90-argon-oneup.conf 2>/dev/null || true
    rm -f /etc/systemd/system/multi-user.target.wants/argon-unused-ethernet.service 2>/dev/null || true
    systemctl stop argon-unused-ethernet.service 2>/dev/null || true
    if [ -x /usr/sbin/argon-unused-ethernet ]; then
        /usr/sbin/argon-unused-ethernet stop 2>/dev/null || true
    elif command -v ip >/dev/null 2>&1; then
        ip link set dev eth0 up 2>/dev/null || true
    fi
    if command -v nmcli >/dev/null 2>&1 && \
       systemctl is-active --quiet NetworkManager 2>/dev/null; then
        nmcli general reload 2>/dev/null || true
    fi
fi

exit 0
