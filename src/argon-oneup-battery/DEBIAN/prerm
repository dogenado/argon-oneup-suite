#!/bin/bash
set -e

if [ "$1" = "remove" ] || [ "$1" = "deconfigure" ]; then
    # Detach I2C device if manually instantiated
    if [ -e /sys/bus/i2c/devices/1-0064 ] && [ -w /sys/bus/i2c/devices/i2c-1/delete_device ]; then
        echo 0x64 > /sys/bus/i2c/devices/i2c-1/delete_device 2>/dev/null || true
    fi

    # Unload module
    modprobe -r oneUpPower 2>/dev/null || true

    # Remove all registered DKMS versions, not just a hardcoded one.
    if command -v dkms >/dev/null 2>&1; then
        VERSIONS=$(dkms status 2>/dev/null | awk -F'[/,:]' '/^oneUpPower\// {gsub(/ /, "", $2); print $2}' | sort -u) || true
        if [ -z "$VERSIONS" ]; then
            # Fallback for a damaged DKMS database: use the installed source tree.
            DKMS_DIR=$(ls -d /usr/src/oneUpPower-* 2>/dev/null | sort -V | tail -n1)
            if [ -n "$DKMS_DIR" ] && [ -f "$DKMS_DIR/dkms.conf" ]; then
                V=$(grep '^PACKAGE_VERSION=' "$DKMS_DIR/dkms.conf" | cut -d'"' -f2)
                if [ -n "$V" ]; then
                    VERSIONS="$V"
                fi
            fi
        fi
        for V in $VERSIONS; do
            dkms remove -m oneUpPower -v "$V" --all 2>/dev/null || true
        done
        for KDIR in /lib/modules/*; do
            [ -d "$KDIR" ] || continue
            depmod -a "$(basename "$KDIR")" 2>/dev/null || true
        done
    fi
fi

exit 0
