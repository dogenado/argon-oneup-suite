#!/bin/bash
set -e

# The namespace helper needs CAP_SYS_ADMIN for unshare()/mount().
# Use file capabilities only; never install a SUID-root fallback.
if [ -f /usr/bin/ksystemstats-ns-helper ]; then
    chmod 0755 /usr/bin/ksystemstats-ns-helper
    if setcap cap_sys_admin+ep /usr/bin/ksystemstats-ns-helper 2>/dev/null; then
        echo "[ksystemstats-rpi5-fix] Configured cap_sys_admin on /usr/bin/ksystemstats-ns-helper"
    else
        echo "[ksystemstats-rpi5-fix] WARNING: could not set cap_sys_admin on the namespace helper." >&2
        echo "                 The ksystemstats fix will remain inactive until the capability is set." >&2
    fi
fi

# Apply cpu_thermal patch to ksystemstats_plugin_cpu.so if present
if [ -x /usr/sbin/ksystemstats-rpi5-fix ]; then
    /usr/sbin/ksystemstats-rpi5-fix || true
fi

# Reload systemd user daemon and restart plasma-ksystemstats only if active
for uid_dir in /run/user/[0-9]*; do
    if [ -d "$uid_dir" ]; then
        uid=$(basename "$uid_dir")
        sudo -u "#$uid" XDG_RUNTIME_DIR="$uid_dir" DBUS_SESSION_BUS_ADDRESS="unix:path=${uid_dir}/bus" \
            systemctl --user daemon-reload 2>/dev/null || true
        sudo -u "#$uid" XDG_RUNTIME_DIR="$uid_dir" DBUS_SESSION_BUS_ADDRESS="unix:path=${uid_dir}/bus" \
            systemctl --user try-restart plasma-ksystemstats.service 2>/dev/null || true
    fi
done

echo "[ksystemstats-rpi5-fix] KDE System Monitor integration configured."
exit 0
