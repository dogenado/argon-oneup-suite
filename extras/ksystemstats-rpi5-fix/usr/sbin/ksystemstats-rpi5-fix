#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""
ksystemstats-rpi5-fix — Patches ksystemstats_plugin_cpu.so to map cpu_thermal on Raspberry Pi 5.

The patch offsets below target the tested KDE Plasma 6 build of the plugin.
Unknown layouts are left untouched and reported instead of being patched
blindly.
"""
import os
import shutil
import struct
import sys

PLUGIN_MIN_SIZE = 0x12000
SERIAL_OFFSET = 0x11a80
SERIAL_MAGIC = b"Serial\x00"
CPUINFO_OFFSET = 0x11a60
CPUINFO_VALUE = b"cpu_thermal\x00\x00\x00\x00\x00"


def patch_values():
    return {
        0xbb98: 0xb4000001 | (((-117) & 0x7ffff) << 5),
        0xbba8: 0x54000001 | (((-121) & 0x7ffff) << 5),
        0xbbb4: 0x14000000 | ((-124) & 0x3ffffff),
        0xb6d8: 0xb9000bff,
        0xb6dc: 0xb90013ff,
        0xb54c: 0x94000000 | (((0x9820 - 0xb54c) >> 2) & 0x3ffffff),
    }


restore_mode = "--restore" in sys.argv[1:]
args = [a for a in sys.argv[1:] if not a.startswith("-")]
root = args[0] if args and os.path.isdir(args[0]) else ""

cpu_path = (
    os.path.join(root, "usr/lib/aarch64-linux-gnu/qt6/plugins/ksystemstats/ksystemstats_plugin_cpu.so")
    if root
    else "/usr/lib/aarch64-linux-gnu/qt6/plugins/ksystemstats/ksystemstats_plugin_cpu.so"
)
stamp_dir = os.path.join(root, "var/lib/ksystemstats-rpi5-fix") if root else "/var/lib/ksystemstats-rpi5-fix"
stamp_file = os.path.join(stamp_dir, "ksystemstats.stamp")
backup_file = os.path.join(stamp_dir, "ksystemstats_plugin_cpu.so.orig")

if restore_mode:
    if os.path.isfile(backup_file) and os.path.isfile(cpu_path):
        try:
            tmp_path = cpu_path + ".restore.tmp"
            shutil.copy2(backup_file, tmp_path)
            os.chmod(tmp_path, 0o644)
            os.replace(tmp_path, cpu_path)
            print("[argon-oneup-sensors] Restored original ksystemstats_plugin_cpu.so")
        except Exception as e:
            print(f"[argon-oneup-sensors] Warning: could not restore ksystemstats_plugin_cpu.so: {e}", file=sys.stderr)
    sys.exit(0)

if os.path.isfile(cpu_path):
    # Fast path: check stamp to avoid redundant file I/O on unrelated apt invocations
    try:
        cur_mtime = str(int(os.path.getmtime(cpu_path)))
        if os.path.isfile(stamp_file):
            with open(stamp_file, "r") as sf:
                if sf.read().strip() == cur_mtime:
                    sys.exit(0)
    except Exception:
        pass

    try:
        with open(cpu_path, "rb") as f:
            data = bytearray(f.read())

        patch = patch_values()
        changed = False

        if len(data) >= PLUGIN_MIN_SIZE and data[SERIAL_OFFSET:SERIAL_OFFSET + len(SERIAL_MAGIC)] == SERIAL_MAGIC:
            already_patched = (
                all(struct.unpack_from("<I", data, off)[0] == insn for off, insn in patch.items())
                and data[CPUINFO_OFFSET:CPUINFO_OFFSET + len(CPUINFO_VALUE)] == CPUINFO_VALUE
            )
            if not already_patched:
                # Never patch without a recoverable backup.
                try:
                    os.makedirs(stamp_dir, exist_ok=True)
                    shutil.copy2(cpu_path, backup_file)
                except Exception as e:
                    print(f"[ksystemstats-rpi5-fix] Cannot create backup ({e}); leaving plugin unchanged.", file=sys.stderr)
                    sys.exit(0)

                for off, insn in patch.items():
                    struct.pack_into("<I", data, off, insn)
                data[CPUINFO_OFFSET:CPUINFO_OFFSET + len(CPUINFO_VALUE)] = CPUINFO_VALUE
                changed = True
        else:
            print("[ksystemstats-rpi5-fix] Unrecognized ksystemstats plugin layout; leaving it unchanged.", file=sys.stderr)

        if changed:
            # Verify every write before replacing the original file.
            verified = (
                all(struct.unpack_from("<I", data, off)[0] == insn for off, insn in patch.items())
                and data[CPUINFO_OFFSET:CPUINFO_OFFSET + len(CPUINFO_VALUE)] == CPUINFO_VALUE
            )
            if not verified:
                print("[ksystemstats-rpi5-fix] Patch verification failed; original left unchanged.", file=sys.stderr)
            else:
                tmp_path = cpu_path + ".tmp"
                with open(tmp_path, "wb") as f:
                    f.write(data)
                os.chmod(tmp_path, 0o644)
                os.replace(tmp_path, cpu_path)
                print("[argon-oneup-sensors] Successfully patched ksystemstats_plugin_cpu.so for cpu_thermal")

        # Update stamp, including for unknown layouts, so apt does not retry
        # until the plugin file changes.
        try:
            os.makedirs(stamp_dir, exist_ok=True)
            new_mtime = str(int(os.path.getmtime(cpu_path)))
            with open(stamp_file, "w") as sf:
                sf.write(new_mtime)
        except Exception:
            pass
    except Exception as e:
        print(f"[ksystemstats-rpi5-fix] Warning: could not patch ksystemstats_plugin_cpu: {e}", file=sys.stderr)
